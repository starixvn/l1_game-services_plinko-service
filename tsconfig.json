{
    "compilerOptions": {
        "outDir": "./build",
        "target": "ESNext",
        "types": ["node", "jest"],
        "module": "ESNext",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["**/*.ts", "configs/**/*.js", "tests/integration-tests/global-teardown.cjs", "tests/integration-tests/global-setup.cjs", "tests/integration-tests/models/game-config.js"],
    "exclude": ["node_modules"]
}
